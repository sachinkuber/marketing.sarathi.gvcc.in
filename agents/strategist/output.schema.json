{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brief": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "positioning": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "paragraph": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "required": ["statement", "paragraph"],
              "additionalProperties": false
            },
            "audiences": {
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "needs": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "where": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": ["name", "needs", "message", "where"],
                "additionalProperties": false
              }
            },
            "themes": {
              "minItems": 4,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "topics": {
                    "minItems": 2,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                },
                "required": ["name", "why", "topics"],
                "additionalProperties": false
              }
            },
            "channels": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "channel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "audiences": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": ["channel", "audiences", "why"],
                "additionalProperties": false
              }
            },
            "cadence": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "channel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "postsPerWeek": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 21
                  }
                },
                "required": ["channel", "postsPerWeek"],
                "additionalProperties": false
              }
            },
            "goals": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "from": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": ["metric", "from", "to"],
                "additionalProperties": false
              }
            },
            "choicesMade": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "lead_audience",
                      "positioning_angle",
                      "first_channels",
                      "content_focus",
                      "posting_rhythm",
                      "goal_focus"
                    ]
                  },
                  "picked": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "notTaken": {
                    "maxItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  }
                },
                "required": ["key", "picked", "notTaken"],
                "additionalProperties": false
              }
            },
            "factIds": {
              "minItems": 1,
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            }
          },
          "required": [
            "positioning",
            "audiences",
            "themes",
            "channels",
            "cadence",
            "goals",
            "choicesMade",
            "factIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ask": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "why": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "options": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "suggested": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["text", "why", "options", "suggested"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["brief", "ask"],
  "additionalProperties": false
}
