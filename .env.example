# Local development database (see infra/dev/compose.yaml), superuser. Not set here on purpose: the
# tests (packages/test-support) fall back to this URL when DATABASE_URL is unset. Do not run the tests
# with the run-time-role URL below exported.
# DATABASE_URL=postgres://mkt:mkt_dev_only@127.0.0.1:54329/mkt_dev

# Core service (apps/core)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://mkt_app:CHANGE_ME@127.0.0.1:54329/mkt_dev
# The audit-writer role: used only for audit entries that belong to no business transaction.
AUDIT_DATABASE_URL=postgres://mkt_audit_writer:CHANGE_ME@127.0.0.1:54329/mkt_dev
# The queue role: reads and writes the job queue schema only.
QUEUE_DATABASE_URL=postgres://mkt_queue:CHANGE_ME@127.0.0.1:54329/mkt_dev
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Three different secrets: the worker's bearer credential (sent with every worker request, never used
# for signing), the per-attempt tokens, and sessions.
WORKER_SECRET=CHANGE_ME_at_least_32_characters_long
ATTEMPT_TOKEN_SECRET=CHANGE_ME_another_32_characters_or_more
# The fourth, different from the three above: the key n8n signs its trigger calls with.
TRIGGER_SECRET=CHANGE_ME_a_fourth_32_characters_or_more
QUEUE_BACKLOG_LIMIT=2000
PUBLIC_ORIGIN=https://stg.marketing.sarathi.gvcc.in
LOG_LEVEL=info

# Worker (apps/worker). The core ignores these. The worker also reads QUEUE_DATABASE_URL and WORKER_SECRET
# above (the same values as the core's).
CORE_URL=http://127.0.0.1:4000
ANTHROPIC_API_KEY=CHANGE_ME
# WORKER_ID=CHANGE_ME_defaults_to_hostname-pid
# JOB_CLASSES=interactive,publishing,production,bulk
PROCESSES_PER_CLASS=1
MODEL_BACKEND=anthropic
RECONCILE_INTERVAL_SECONDS=300
# SUPERVISE_INTERVAL_SECONDS=30

# Daily duties and n8n (apps/core)
# The owner-view role: audit reads, audit verification, the audit export reader and the daily exchange rate.
OWNER_VIEW_DATABASE_URL=postgres://mkt_owner_view:CHANGE_ME@127.0.0.1:54329/mkt_dev
# Set to true once the daily n8n workflow is live: a heartbeat older than 26 hours then raises an alert.
N8N_HEARTBEAT_EXPECTED=false

# Mail (apps/core). Set both or neither: neither means no mail is sent (every send fails and is logged).
# SMTP_URL carries the credentials, so keep it out of the repository and out of logs.
# SMTP_URL=smtps://USER:CHANGE_ME@smtp.example.invalid:465
# MAIL_FROM=Marketing Sarathi <no-reply@example.invalid>
