# Local development database (see infra/dev/compose.yaml), superuser. Not set here on purpose: the
# tests (packages/test-support) fall back to this URL when DATABASE_URL is unset. Do not run the tests
# with the run-time-role URL below exported.
# DATABASE_URL=postgres://mkt:mkt_dev_only@127.0.0.1:54329/mkt_dev

# Core service (apps/core)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://mkt_app:CHANGE_ME@127.0.0.1:54329/mkt_dev
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
PUBLIC_ORIGIN=https://stg.marketing.sarathi.gvcc.in
LOG_LEVEL=info
