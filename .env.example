# Local development database (see infra/dev/compose.yaml), superuser. Not set here on purpose: the
# tests (packages/test-support) fall back to this URL when DATABASE_URL is unset. Do not run the tests
# with the run-time-role URL below exported.
# DATABASE_URL=postgres://mkt:mkt_dev_only@127.0.0.1:54329/mkt_dev

# Core service (apps/core)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://mkt_app:CHANGE_ME@127.0.0.1:54329/mkt_dev
# The audit-writer role: used only for audit entries that belong to no business transaction.
AUDIT_DATABASE_URL=postgres://mkt_audit_writer:CHANGE_ME@127.0.0.1:54329/mkt_dev
# The queue role: reads and writes the job queue schema only.
QUEUE_DATABASE_URL=postgres://mkt_queue:CHANGE_ME@127.0.0.1:54329/mkt_dev
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Three different secrets: the worker's request signing, the per-attempt tokens, and sessions.
WORKER_SECRET=CHANGE_ME_at_least_32_characters_long
ATTEMPT_TOKEN_SECRET=CHANGE_ME_another_32_characters_or_more
QUEUE_BACKLOG_LIMIT=2000
PUBLIC_ORIGIN=https://stg.marketing.sarathi.gvcc.in
LOG_LEVEL=info
