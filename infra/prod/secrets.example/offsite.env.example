# /opt/mkt/secrets/offsite.env (root, 0600). Read by the offsite service only, which copies the encrypted backups
# off the server (docs/operations.md, "Backups"). No database setting belongs here.
# The remote and path: the script writes to <remote>/daily/ and <remote>/monthly/. Blank: nothing is copied and the
# run says so.
RCLONE_REMOTE=
# For the R2 bucket mkt-backups, set RCLONE_REMOTE=r2:mkt-backups/mkt and fill in the remote (uncomment). The key
# needs Object Read as well as Write (rclone's --immutable reads each object before writing); the access key id
# and the secret are credentials.
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=<access key id>
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=<secret access key>
# RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
