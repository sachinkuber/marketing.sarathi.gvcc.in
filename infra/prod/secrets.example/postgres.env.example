# /opt/mkt/secrets/postgres.env (root, 0600). Read by postgres and by ops.
# Every CHANGE_ME is replaced on the server, for example with `openssl rand -hex 32` (hex keeps the URL valid).
# The database superuser's password: postgres sets it when it first creates its data (the volume mkt_pg).
POSTGRES_PASSWORD=CHANGE_ME
# The same password, for ops (migrations, role passwords, queue install). Host `postgres` on the data network.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/mkt
