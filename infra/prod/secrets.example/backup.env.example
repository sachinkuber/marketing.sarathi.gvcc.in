# /opt/mkt/secrets/backup.env (root, 0600). Read by the backup service only (docs/operations.md, "Backups").
# The owner's age public key (age1..., from `age-keygen` on the owner's own machine): every backup is encrypted
# to it. The private key is never put on the server.
BACKUP_AGE_RECIPIENT=CHANGE_ME
# The off-server copy (A4): an rclone remote and path, for example r2:<bucket>/mkt. Blank until the bucket
# exists: the backup then makes no off-server copy and says so in its log.
RCLONE_REMOTE=
# The remote itself, by rclone's environment variables (uncomment and fill in with the bucket; the access key
# id and the secret are credentials):
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=<access key id>
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=<secret access key>
# RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
