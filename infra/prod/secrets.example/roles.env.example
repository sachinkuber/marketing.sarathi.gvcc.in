# /opt/mkt/secrets/roles.env (root, 0600). Read by ops only: `prepare` gives each run-time role this password.
# Four different values (`openssl rand -hex 32` each); core.env and worker.env carry the same ones in their URLs.
MKT_APP_PASSWORD=CHANGE_ME
MKT_AUDIT_WRITER_PASSWORD=CHANGE_ME
MKT_QUEUE_PASSWORD=CHANGE_ME
MKT_OWNER_VIEW_PASSWORD=CHANGE_ME
