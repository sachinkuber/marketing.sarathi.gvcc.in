# /opt/mkt/secrets/worker.env (root, 0600). Read by the worker. CORE_URL is set in compose.yaml (http://core:4000,
# on the worker network). In production the worker refuses to start while any value contains CHANGE_ME.
NODE_ENV=production
# The queue role's URL, with its password from roles.env (the same as in core.env).
QUEUE_DATABASE_URL=postgres://mkt_queue:CHANGE_ME@postgres:5432/mkt
# The same value as WORKER_SECRET in core.env.
WORKER_SECRET=CHANGE_ME
MODEL_BACKEND=anthropic
ANTHROPIC_API_KEY=CHANGE_ME
PROCESSES_PER_CLASS=1
RECONCILE_INTERVAL_SECONDS=300
# Error reporting: blank means none. The DSN is a credential.
SENTRY_DSN=
# WORKER_ID=        (defaults to hostname-pid)
# JOB_CLASSES=      (defaults to interactive,publishing,production,bulk)
# SUPERVISE_INTERVAL_SECONDS=
# RELEASE=          (label on error reports; unset means dev)
