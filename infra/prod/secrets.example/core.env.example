# /opt/mkt/secrets/core.env (root, 0600). Read by the core. In production the core refuses to start while any
# value contains CHANGE_ME, while PUBLIC_ORIGIN is not https, or with TRUST_PROXY unset (.env.example has more).
NODE_ENV=production
LOG_LEVEL=info
# One role per URL, each with its password from roles.env. Host `postgres` on the data network.
DATABASE_URL=postgres://mkt_app:CHANGE_ME@postgres:5432/mkt
AUDIT_DATABASE_URL=postgres://mkt_audit_writer:CHANGE_ME@postgres:5432/mkt
QUEUE_DATABASE_URL=postgres://mkt_queue:CHANGE_ME@postgres:5432/mkt
OWNER_VIEW_DATABASE_URL=postgres://mkt_owner_view:CHANGE_ME@postgres:5432/mkt
# Four different secrets of at least 32 characters (`openssl rand -hex 32` each). WORKER_SECRET is also in
# worker.env, with the same value.
AUTH_SECRET=CHANGE_ME
WORKER_SECRET=CHANGE_ME
ATTEMPT_TOKEN_SECRET=CHANGE_ME
TRIGGER_SECRET=CHANGE_ME
QUEUE_BACKLOG_LIMIT=2000
PUBLIC_ORIGIN=https://marketing.sarathi.gvcc.in
# One proxy (on the host) in front of the core.
TRUST_PROXY=1
# true once the daily n8n workflow is live.
N8N_HEARTBEAT_EXPECTED=false
# Mail: both or neither (blank means no mail). SMTP_URL carries the mail password.
SMTP_URL=
MAIL_FROM=
# Error reporting: blank means none. The DSN is a credential.
SENTRY_DSN=
# RELEASE=  (label on error reports; unset means dev)
# Write-once audit copies in an S3-compatible bucket (R2): URL, BUCKET, KEY_ID and SECRET together, or all blank
# for none. KEY_ID and SECRET are credentials. OBJECT_LOCK=true only for a bucket with Object Lock (R2 keeps
# retention in a bucket rule, so false there).
AUDIT_STORE_URL=
AUDIT_STORE_BUCKET=
AUDIT_STORE_KEY_ID=
AUDIT_STORE_SECRET=
AUDIT_STORE_RETENTION_DAYS=400
AUDIT_STORE_OBJECT_LOCK=false
