# /opt/mkt/compose.env (root, 0600): the settings that docker compose and the worker's egress firewall must agree
# on. Copied from infra/prod/compose.env.example at installation (docs/operations.md). Read by every compose
# command (`docker compose --env-file /opt/mkt/compose.env ...`) and by the firewall unit (EnvironmentFile=).
# It must stay valid for all three readers (systemd, a POSIX shell, compose): one KEY=value per line, comments on
# their own lines only (a comment after a value would become part of it), double quotes around a value with spaces.
#
# The egress bridge's name, at most 15 characters. compose.yaml and mkt-egress.sh default to the same.
MKT_EGRESS_BRIDGE=mkt-egress0
# The egress subnet. Change it only if this range is already used on the host or its network.
MKT_EGRESS_SUBNET=10.247.73.0/24
# The host's upstream DNS resolvers, space-separated, when they cannot be read from resolv.conf at boot:
# MKT_EGRESS_DNS="192.0.2.53 198.51.100.53"
